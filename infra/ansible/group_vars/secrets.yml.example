# Copy to secrets.yml (plaintext, gitignored — NO Ansible Vault) and fill in.
# These are auto-loaded by Ansible alongside group_vars/all.yml.
#
# WireGuard private keys:
#   vps_wg_private_key:     contents of /etc/wireguard/server_private.key on the VPS
#   macbook_wg_private_key: contents of /etc/wireguard/private.key on the MacBook

vps_wg_private_key: "REPLACE_WITH_VPS_PRIVATE_KEY"
macbook_wg_private_key: "REPLACE_WITH_MACBOOK_PRIVATE_KEY"
